# PostgreSQL connection string. Use a dedicated runtime role for the app;
# do not run the application as a PostgreSQL superuser or schema owner.
DATABASE_URL=postgresql://app_runtime:change-me@localhost:5432/syj_hcm

# Required authentication secret (32+ random characters in production).
SESSION_SECRET=replace-with-a-long-random-string

# Optional postgres.js pool settings.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=20
DATABASE_CONNECT_TIMEOUT=10

# Development-only seed gate.
ALLOW_DEV_SEED=false

# Public application URL used for generated offer response links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL migration connection (privileged migration role)
DATABASE_MIGRATION_URL=postgres://postgres:change-me@localhost:5432/syj_hcm

# PostgreSQL runtime role used by the application
DATABASE_RUNTIME_ROLE=app_runtime

# Candidate document storage
DOCUMENT_STORAGE_PATH=./data/candidate-documents

# Document scanner mode
DOCUMENT_SCANNER_MODE=disabled
