# Path to the SQLite database file (created automatically on first migrate)
DATABASE_PATH=./data/syj-hcm.db

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# Set to "true" to allow the dev seed script to run. Never set true in production.
ALLOW_DEV_SEED=false

# Phase 2.3 candidate document storage. Keep this path private and outside public static assets.
DOCUMENT_STORAGE_PATH=./data/storage
# Scanner mode is intentionally explicit. 'unavailable' never claims malware-free status.
DOCUMENT_SCANNER_MODE=unavailable
