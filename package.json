{
  "name": "syj-hcm",
  "version": "0.14.1-alpha",
  "private": true,
  "description": "SYJ-HCM - Phase 2.5 offers and offer management",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env --import tsx scripts/start.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:import-sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:backup-drill": "bash scripts/backup-restore-drill.sh",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "platform:grant-admin": "tsx scripts/grant-platform-admin.ts",
    "test:foundation": "node --import tsx --test --test-reporter=spec tests/postgres-foundation.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "nanoid": "^5.0.7",
    "next": "15.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.13.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.7",
    "postcss": "^8.5.28",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
